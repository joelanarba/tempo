# Copy to /etc/tempo/tempo.env and fill in real values. Never commit the real file.

# PostgreSQL (Neon). Must be a JDBC URL.
DATABASE_URL=jdbc:postgresql://YOUR-NEON-HOST/tempo?sslmode=require
DATABASE_USERNAME=tempo_user
DATABASE_PASSWORD=change-me

# Redis
REDIS_URL=redis://localhost:6379

# JWT signing secret. Must be at least 32 characters (256 bits) for HS256.
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes
JWT_EXPIRY_MS=900000
JWT_REFRESH_EXPIRY_MS=604800000

# Availability read-cache TTL (seconds)
AVAILABILITY_CACHE_TTL_SECONDS=30

# Public base URL of the deployment
APP_BASE_URL=https://tempo.example.com

# Server port (proxied by Nginx)
SERVER_PORT=8080

# Only used when running with the 'setup' profile to seed an admin/space/resources.
SEED_ADMIN_PASSWORD=

# Waitlist and auto-promotion
# How long a HELD offer is valid before the scheduler expires and cascades it (seconds).
WAITLIST_HOLD_SECONDS=120
# How often the expiry sweep runs (milliseconds).
WAITLIST_SWEEP_MS=10000
