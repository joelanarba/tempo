{
  "info": {
    "name": "Tempo API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Manual local demonstration. Set password variables in a private environment. Run Setup and Booking and waitlist in order, with WebSocket clients subscribed first. Other requests are optional; do not run every folder blindly. Clear generated variables before a fresh demonstration. Never export captured credentials."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "refresh_token",
      "value": ""
    },
    {
      "key": "waiter_token",
      "value": ""
    },
    {
      "key": "waiter_refresh",
      "value": ""
    },
    {
      "key": "admin_token",
      "value": ""
    },
    {
      "key": "member_email",
      "value": ""
    },
    {
      "key": "waiter_email",
      "value": ""
    },
    {
      "key": "spaceId",
      "value": ""
    },
    {
      "key": "resourceId",
      "value": ""
    },
    {
      "key": "bookingId",
      "value": ""
    },
    {
      "key": "claimedBookingId",
      "value": ""
    },
    {
      "key": "entryId",
      "value": ""
    },
    {
      "key": "demo_date",
      "value": ""
    },
    {
      "key": "slot_start",
      "value": ""
    },
    {
      "key": "slot_end",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "for (const name of ['member_email', 'waiter_email']) {",
          "  if (!pm.collectionVariables.get(name)) pm.collectionVariables.set(name, pm.variables.replaceIn('{{$guid}}') + '@tempo.test');",
          "}",
          "if (!pm.collectionVariables.get('demo_date')) {",
          "  const day = new Date(); day.setUTCDate(day.getUTCDate() + 1);",
          "  const date = day.toISOString().slice(0, 10);",
          "  pm.collectionVariables.set('demo_date', date);",
          "  pm.collectionVariables.set('slot_start', date + 'T09:00:00Z');",
          "  pm.collectionVariables.set('slot_end', date + 'T10:00:00Z');",
          "}",
          "const body = pm.request.body && pm.request.body.raw || '';",
          "for (const name of ['admin_password', 'member_password', 'waiter_password']) {",
          "  if (body.includes('{{' + name + '}}') && !pm.variables.get(name)) throw new Error('Set ' + name + ' in a private environment.');",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
