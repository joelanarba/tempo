            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('Response envelope', () => pm.expect(json.success).to.eql(true));",
                  "if (json.success) pm.collectionVariables.set('access_token', json.data.accessToken);",
