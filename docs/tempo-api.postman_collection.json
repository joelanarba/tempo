              "mode": "raw",
              "raw": "{\n  \"email\": \"{{member_email}}\",\n  \"password\": \"{{member_password}}\",\n  \"firstName\": \"Demo\",\n  \"lastName\": \"Member\"\n}",
              "options": {
                "raw": {
                  "language": "json"
